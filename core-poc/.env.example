# ==============================================================================
# LOGISTIC-Q QUANTUM COMPUTING CORE CONFIGURATION ENVIRONMENT
# Instructions: Rename this file to '.env' and populate with your API credentials.
# WARNING: Never commit the actual '.env' file to open-source repositories!
# ==============================================================================

# 1. Framework Operational Mode
# Options: PRODUCTION (Live QPU), SIMULATION (Classical Fallback Mock)
LOGISTIC_Q_MODE=SIMULATION

# 2. D-Wave Leap Quantum Cloud Credentials
DWAVE_API_ENDPOINT=https://dwavesys.com
DWAVE_API_TOKEN=YOUR_DWAVE_LEAP_TOKEN_HERE
DWAVE_SOLVER_NAME=Advantage_system6.1

# 3. IBM Quantum Experience Configuration
IBMQ_API_TOKEN=YOUR_IBM_QUANTUM_RUNTIME_TOKEN_HERE
IBMQ_INSTANCE=ibm-q/open/main

# 4. AWS Braket Integration (If using AWS Infrastructure)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_DEFAULT_REGION=us-east-1
BRAKET_S3_BUCKET=amazon-braket-logistic-q-output
